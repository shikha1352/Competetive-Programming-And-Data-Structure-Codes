#include <iostream>
#include <cstdlib>
using namespace std;

char brd[3][3] = { {'1','2','3'}, {'4','5','6'}, {'7','8','9'} };
char turn = 'X';  // Player always X, AI always O
bool draw = false;

void bord() {
    system("cls"); // Windows clear
    cout << "\n\n\tT I C  T A C  T O E\n";
    cout << "\n\tPlayer [X] (You)";
    cout << "\n\tAI     [O] (Greedy)\n\n";

    cout << "\t\t      |     |     \n";
    cout << "\t\t  " << brd[0][0] << "   |  " << brd[0][1] << "  |  " << brd[0][2] << "  \n";
    cout << "\t\t      |     |     \n";
    cout << "\t\t _____|_____|_____\n";
    cout << "\t\t      |     |     \n";
    cout << "\t\t  " << brd[1][0] << "   |  " << brd[1][1] << "  |  " << brd[1][2] << "  \n";
    cout << "\t\t      |     |     \n";
    cout << "\t\t _____|_____|_____\n";
    cout << "\t\t      |     |     \n";
    cout << "\t\t  " << brd[2][0] << "   |  " << brd[2][1] << "  |  " << brd[2][2] << "  \n";
    cout << "\t\t      |     |     \n\n";
}

bool movesLeft() {
    for (int i = 0; i < 3; i++)
        for (int j = 0; j < 3; j++)
            if (brd[i][j] != 'X' && brd[i][j] != 'O')
                return true;
    return false;
}

char checkWinner() {
    // Rows
    for (int i = 0; i < 3; i++)
        if (brd[i][0] == brd[i][1] && brd[i][1] == brd[i][2])
            return brd[i][0];

    // Columns
    for (int i = 0; i < 3; i++)
        if (brd[0][i] == brd[1][i] && brd[1][i] == brd[2][i])
            return brd[0][i];

    // Diagonals
    if (brd[0][0] == brd[1][1] && brd[1][1] == brd[2][2])
        return brd[0][0];
    if (brd[0][2] == brd[1][1] && brd[1][1] == brd[2][0])
        return brd[0][2];

    return 'N'; // No winner yet
}

void player_turn() {
    int choice;
    while (true) {
        cout << "Your turn [X]. Enter location (1-9): ";
        cin >> choice;

        if (choice < 1 || choice > 9) {
            cout << "Invalid input! Try again.\n";
            continue;
        }

        int r = (choice - 1) / 3;
        int c = (choice - 1) % 3;

        if (brd[r][c] != 'X' && brd[r][c] != 'O') {
            brd[r][c] = 'X';
            turn = 'O';
            break;
        }
        else {
            cout << "Box already filled! Try again.\n";
        }
    }
}

void ai_turn() {
    cout << "AI's turn [O] (Greedy)...\n";

    // 1️⃣ Try to win immediately
    for (int i = 0; i < 3; i++) {
        for (int j = 0; j < 3; j++) {
            if (brd[i][j] != 'X' && brd[i][j] != 'O') {
                char backup = brd[i][j];
                brd[i][j] = 'O';
                if (checkWinner() == 'O') return;
                brd[i][j] = backup;
            }
        }
    }

    // 2️⃣ Block player from winning
    for (int i = 0; i < 3; i++) {
        for (int j = 0; j < 3; j++) {
            if (brd[i][j] != 'X' && brd[i][j] != 'O') {
                char backup = brd[i][j];
                brd[i][j] = 'X';
                if (checkWinner() == 'X') {
                    brd[i][j] = 'O';
                    return;
                }
                brd[i][j] = backup;
            }
        }
    }

    // 3️⃣ Take center if free
    if (brd[1][1] != 'X' && brd[1][1] != 'O') {
        brd[1][1] = 'O';
        return;
    }

    // 4️⃣ Take a corner
    int corners[4][2] = {{0,0},{0,2},{2,0},{2,2}};
    for (auto &corner : corners) {
        int r = corner[0], c = corner[1];
        if (brd[r][c] != 'X' && brd[r][c] != 'O') {
            brd[r][c] = 'O';
            return;
        }
    }

    // 5️⃣ Take any available spot
    for (int i = 0; i < 3; i++)
        for (int j = 0; j < 3; j++)
            if (brd[i][j] != 'X' && brd[i][j] != 'O') {
                brd[i][j] = 'O';
                return;
            }
}

bool gameover() {
    char winner = checkWinner();
    if (winner == 'X' || winner == 'O') return false;
    if (!movesLeft()) {
        draw = true;
        return false;
    }
    return true;
}

int main() {
    bord();
    while (gameover()) {
        if (turn == 'X') player_turn();
        else ai_turn();
        turn = (turn == 'X') ? 'O' : 'X';
        bord();
    }

    char winner = checkWinner();
    if (winner == 'X') cout << "You win! 🎉\n";
    else if (winner == 'O') cout << "AI wins! 😈\n";
    else cout << "It's a draw! 🤝\n";

    return 0;
}
